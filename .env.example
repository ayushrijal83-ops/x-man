FLASK_APP=run.py
FLASK_ENV=development
# Required in production (FLASK_ENV=production refuses the development default).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string
DATABASE_URL=sqlite:///hackforge.db

AI_PROVIDER=ollama
AI_MODEL=qwen2.5:0.5b
OLLAMA_URL=http://localhost:11434

OPENAI_API_KEY=

# M06 vision analysis (local model, no API key). See docs/PROJECT_PROGRESS.md.
VISION_ENABLED=true
# VISION_MODEL_PATH=instance/models/siglip-base-patch16-224
# VISION_CONFIDENCE_THRESHOLD=0.6

# M10: public authority sign-up creates district managers, so it is off by default.
# Only enable for a throwaway local demo.
AUTHORITY_SELF_REGISTRATION=false

# M12 Web Push (emergency alerts outside the website). Generate a pair with: flask push-keys
# Keep VAPID_PRIVATE_KEY secret (never commit it). Unset = browser push disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
# Lowest severity that triggers the in-website alarm and an emergency push (low|medium|high|critical)
EMERGENCY_MIN_SEVERITY=high
